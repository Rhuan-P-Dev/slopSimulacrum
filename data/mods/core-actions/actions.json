  "dropItem": {
    "description": "Drop an item from your inventory onto the map near you, where others can pick it up.",
    "prose": {
      "verbPhrase": "dropped an item",
      "instrumental": { "verb": "drop", "targetLink": "direct" }
    },
    "targetingType": "spatial",
    "range": 100,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "strength",
        "minValue": 1
      }
    ],
    "consequences": [
      {
        "type": "dropItem",
        "target": "target",
        "params": {
          "entityId": ":entityId",
          "itemId": ":itemId",
          "itemType": ":itemType",
          "targetX": ":targetX",
          "targetY": ":targetY"
        }
      },
      {
        "type": "log",
        "target": "entity",
        "level": "info",
        "message": "Item ':itemType' dropped at (:targetX, :targetY)"
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Dropping item failed - no item equipped or range exceeded"
      }
    ]
  },
  "placeMachine": {
    "description": "Place the machine you are carrying into the world near you, turning it into a self-running machine (e.g. a Knife Generator that forges one knife each turn). The carried item is consumed. Pass the machine's item type (e.g. 'knifeGenerator').",
    "prose": {
      "verbPhrase": "placed a machine",
      "instrumental": { "verb": "place", "targetLink": "direct" }
    },
    "targetingType": "spatial",
    "range": 100,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "strength",
        "minValue": 1
      }
    ],
    "consequences": [
      {
        "type": "placeMachine",
        "target": "entity",
        "params": {
          "entityId": ":entityId",
          "itemType": ":itemType"
        }
      },
      {
        "type": "log",
        "target": "entity",
        "level": "info",
        "message": "Placed machine '(:itemType)' near you."
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Placing machine failed - no carried machine item to place."
      }
    ]
  },
  "retrieveMachine": {
    "description": "Retrieve a machine you placed earlier from the world and return it to your inventory. Its stored contents (e.g. forged knives) spill to the floor at the machine's position first. Pass the machine type (e.g. 'knifeGenerator').",
    "prose": {
      "verbPhrase": "retrieved a machine",
      "instrumental": { "verb": "retrieve", "targetLink": "direct" }
    },
    "targetingType": "spatial",
    "range": 50,
