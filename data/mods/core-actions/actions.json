{
  "move": {
    "description": "Advance your droid toward a target point in the current room using your rolling wheels.",
    "prose": {
      "verbPhrase": "moved"
    },
    "targetingType": "spatial",
    "requirements": [
      {
        "trait": "Movement",
        "stat": "move",
        "minValue": 5
      }
    ],
    "consequences": [
      {
        "type": "deltaSpatial",
        "target": "entity",
        "params": {
          "speed": ":Movement.move"
        }
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'move' failed - requirement not met"
      }
    ]
  },
  "dash": {
    "description": "Sprint: move twice as fast toward the target point, wearing your chassis down (a small loss of existence).",
    "prose": {
      "verbPhrase": "dashed"
    },
    "targetingType": "spatial",
    "requirements": [
      {
        "trait": "Movement",
        "stat": "move",
        "minValue": 5
      },
      {
        "trait": "Physical",
        "stat": "existence",
        "minValue": 0.3
      }
    ],
    "consequences": [
      {
        "type": "deltaSpatial",
        "target": "entity",
        "params": {
          "speed": ":Movement.move*2"
        }
      },
      {
        "type": "updateComponentStatDelta",
        "target": "self",
        "params": {
          "trait": "Physical",
          "stat": "existence",
          "value": -0.05
        }
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'dash' failed - requirement not met"
      }
    ]
  },
  "crossDoor": {
    "description": "Walk through one door of the room you are standing in and appear in the room it leads to. Pass the door name exactly as your Exits line shows it (e.g. 'right_door', which also prints that door's position); the server resolves the room beyond and where inside it you appear. You must be standing at the door - walk to its position first.",
    "prose": {
      "verbPhrase": "walked through a door"
    },
    "targetingType": "spatial",
    "range": 50,
    "requirements": [
      {
        "trait": "Movement",
        "stat": "move",
        "minValue": 5
      }
    ],
    "consequences": [
      {
        "type": "traverseDoor",
        "target": "entity",
        "params": {
          "entityId": ":entityId",
          "door": ":door"
        }
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'crossDoor' failed - requirement not met"
      }
    ]
  },
