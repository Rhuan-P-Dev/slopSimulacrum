  "grab": {
    "description": "Lunge at the target and drag it back - the target loses 5 of its move. Requires strength.",
    "prose": {
      "verbPhrase": "grabbed",
      "targetLink": "direct",
      "instrumental": { "verb": "grab" }
    },
    "targetingType": "component",
    "range": 50,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "strength",
        "minValue": 1
      }
    ],
    "consequences": [
      {
        "type": "updateComponentStatDelta",
        "target": "target",
        "params": {
          "trait": "Movement",
          "stat": "move",
          "value": -5
        },
        "expiresInRounds": 1
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'grab' failed - strength too low to grab."
      }
    ]
  },
  "droid punch": {
    "description": "Throw a punch with your arm, dealing impact damage scaled by your Physical.strength. Close-range melee attack.",
    "prose": {
      "verbPhrase": "threw a punch",
      "instrumental": { "verb": "throw a punch" }
    },
    "targetingType": "component",
    "range": 100,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "strength",
        "minValue": 15
      }
    ],
    "consequences": [
      {
        "type": "damageComponent",
        "target": "target",
        "params": {
          "channel": "impact",
          "value": ":Physical.strength"
        }
      },
      {
        "type": "dropMaterialChunk",
        "target": "target"
      },
      {
        "type": "log",
        "target": "self",
        "level": "info",
        "message": ":entityName (:entityId):attackerCompPhrase performed :actionName dealing :damageValue :damageChannel damage to :targetName (:targetId):targetCompPhrase"
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Punch failed for [:entityId] - strength too low"
      }
    ]
  },
  "cut": {
    "description": "Slice the target with an equipped knife, dealing cut damage scaled by the knife's sharpness. The knife loses 1 sharpness with every cut.",
