      "instrumental": { "verb": "pick up", "targetLink": "direct" }
    },
    "targetingType": "component",
    "range": 50,
    "groupPick": {
      "radius": 25,
      "minItems": 2
    },
    "requirements": [
      {
        "trait": "Physical",
        "stat": "strength",
        "minValue": 5
      },
