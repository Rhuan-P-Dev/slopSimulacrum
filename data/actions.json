{
  "move": {
    "targetingType": "spatial",
    "requirements": [
      {
        "trait": "Movement",
        "stat": "move",
        "minValue": 5
      }
    ],
    "consequences": [
      {
        "type": "deltaSpatial",
        "target": "entity",
        "params": { "speed": ":Movement.move" }
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'move' failed - requirement not met"
      }
    ]
  },
  "dash": {
    "targetingType": "spatial",
    "requirements": [
      {
        "trait": "Movement",
        "stat": "move",
        "minValue": 5
      },
      {
        "trait": "Physical",
        "stat": "durability",
        "minValue": 30
      }
    ],
    "consequences": [
      {
        "type": "deltaSpatial",
        "target": "entity",
        "params": { "speed": ":Movement.move*2" }
      },
      {
        "type": "updateComponentStatDelta",
        "target": "self",
        "params": { "trait": "Physical", "stat": "durability", "value": -5 }
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'dash' failed - requirement not met"
      }
    ]
  },
  "selfHeal": {
    "targetingType": "self_target",
    "requirements": [
      {
        "trait": "Movement",
        "stat": "move",
        "minValue": 1
      },
      {
        "trait": "Physical",
        "stat": "durability",
        "minValue": 1
      }
    ],
    "consequences": [
      {
        "type": "updateComponentStatDelta",
        "target": "self",
        "params": { "trait": "Physical", "stat": "durability", "value": 10 }
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'selfHeal' failed - requirement not met"
      }
    ]
  },
  "droid punch": {
    "targetingType": "component",
    "range": 100,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "strength",
        "minValue": 15
      }
    ],
    "consequences": [
      {
        "type": "damageComponent",
        "target": "target",
        "params": {
          "trait": "Physical",
          "stat": "durability",
          "value": "-:Physical.strength"
        }
      },
      {
        "type": "log",
        "target": "self",
        "level": "info",
        "message": "Droid performed a punch dealing :Physical.strength damage!"
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Punch failed - strength too low"
      }
    ]
  },
  "cut": {
    "targetingType": "component",
    "range": 50,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "sharpness",
        "minValue": 20
      }
    ],
    "consequences": [
      {
        "type": "damageComponent",
        "target": "target",
        "params": {
          "trait": "Physical",
          "stat": "durability",
          "value": "-:Physical.sharpness"
        }
      },
      {
        "type": "updateComponentStatDelta",
        "target": "self",
        "params": { "trait": "Physical", "stat": "sharpness", "value": -1 }
      },
      {
        "type": "log",
        "target": "self",
        "level": "info",
        "message": "The knife cuts, dealing :Physical.sharpness damage and losing -1 sharpness."
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'cut' failed - sharpness too low to cut."
      }
    ]
  },
  "dropItem": {
    "targetingType": "spatial",
    "range": 100,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "strength",
        "minValue": 1
      }
    ],
    "consequences": [
      {
        "type": "dropItem",
        "target": "target",
        "params": { "entityId": ":entityId", "itemId": ":itemId", "itemType": ":itemType", "targetX": ":targetX", "targetY": ":targetY" }
      },
      {
        "type": "log",
        "target": "entity",
        "level": "info",
        "message": "Item ':itemType' dropped at (:targetX, :targetY)"
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Dropping item failed - no item equipped or range exceeded"
      }
    ]
  },
  "pickUpItem": {
    "targetingType": "component",
    "range": 50,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "strength",
        "minValue": 5
      },
      {
        "trait": "Physical",
        "stat": "volume",
        "minValue": 1
      }
    ],
    "consequences": [
      {
        "type": "pickUpItem",
        "target": "target",
        "params": {
          "sourceEntityId": ":sourceEntityId",
          "sourceItemId": ":sourceItemId",
          "sourceComponentId": ":sourceComponentId",
          "targetEntityId": ":entityId",
          "targetComponentId": ":targetComponentId"
        }
      },
      {
        "type": "log",
        "target": "entity",
        "level": "info",
        "message": "Item ':itemType' picked up from entity ':sourceEntityId'"
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Pick up failed - insufficient strength or volume, or target out of range"
      }
    ]
  }
}
