{
  "move": {
    "description": "Advance your droid toward a target point in the current room using your rolling wheels.",
    "targetingType": "spatial",
    "requirements": [
      {
        "trait": "Movement",
        "stat": "move",
        "minValue": 5
      }
    ],
    "consequences": [
      {
        "type": "deltaSpatial",
        "target": "entity",
        "params": { "speed": ":Movement.move" }
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'move' failed - requirement not met"
      }
    ]
  },
  "dash": {
    "description": "Sprint: move twice as fast toward the target point, wearing your chassis down (a small loss of existence).",
    "targetingType": "spatial",
    "requirements": [
      {
        "trait": "Movement",
        "stat": "move",
        "minValue": 5
      },
      {
        "trait": "Physical",
        "stat": "existence",
        "minValue": 0.3
      }
    ],
    "consequences": [
      {
        "type": "deltaSpatial",
        "target": "entity",
        "params": { "speed": ":Movement.move*2" }
      },
      {
        "type": "updateComponentStatDelta",
        "target": "self",
        "params": { "trait": "Physical", "stat": "existence", "value": -0.05 }
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'dash' failed - requirement not met"
      }
    ]
  },
  "selfHeal": {
    "description": "Run a self-repair cycle that restores a small amount of existence to your core.",
    "targetingType": "self_target",
    "requirements": [
      {
        "trait": "Movement",
        "stat": "move",
        "minValue": 1
      },
      {
        "trait": "Physical",
        "stat": "existence",
        "minValue": 0.01
      }
    ],
    "consequences": [
      {
        "type": "updateComponentStatDelta",
        "target": "self",
        "params": { "trait": "Physical", "stat": "existence", "value": 0.1 }
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'selfHeal' failed - requirement not met"
      }
    ]
  },
  "droid punch": {
    "description": "Throw a punch with your arm, dealing impact damage scaled by your Physical.strength. Close-range melee attack.",
    "targetingType": "component",
    "range": 100,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "strength",
        "minValue": 15
      }
    ],
    "consequences": [
      {
        "type": "damageComponent",
        "target": "target",
        "params": {
          "channel": "impact",
          "value": ":Physical.strength"
        }
      },
      {
        "type": "dropMaterialChunk",
        "target": "target"
      },
      {
        "type": "log",
        "target": "self",
        "level": "info",
        "message": "Droid performed a punch dealing :Physical.strength impact damage!"
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Punch failed - strength too low"
      }
    ]
  },
  "cut": {
    "description": "Slice the target with an equipped knife, dealing cut damage scaled by the knife's sharpness. The knife loses 1 sharpness with every cut.",
    "targetingType": "component",
    "range": 50,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "sharpness",
        "minValue": 20
      }
    ],
    "consequences": [
      {
        "type": "damageComponent",
        "target": "target",
        "params": {
          "channel": "cut",
          "value": ":Physical.sharpness"
        }
      },
      {
        "type": "dropMaterialChunk",
        "target": "target"
      },
      {
        "type": "updateComponentStatDelta",
        "target": "self",
        "params": { "trait": "Physical", "stat": "sharpness", "value": -1 }
      },
      {
        "type": "log",
        "target": "self",
        "level": "info",
        "message": "The knife cuts, dealing :Physical.sharpness cut damage and losing -1 sharpness."
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Action 'cut' failed - sharpness too low to cut."
      }
    ]
  },
  "dropItem": {
    "description": "Drop an item from your inventory onto the map near you, where others can pick it up.",
    "targetingType": "spatial",
    "range": 100,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "strength",
        "minValue": 1
      }
    ],
    "consequences": [
      {
        "type": "dropItem",
        "target": "target",
        "params": { "entityId": ":entityId", "itemId": ":itemId", "itemType": ":itemType", "targetX": ":targetX", "targetY": ":targetY" }
      },
      {
        "type": "log",
        "target": "entity",
        "level": "info",
        "message": "Item ':itemType' dropped at (:targetX, :targetY)"
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Dropping item failed - no item equipped or range exceeded"
      }
    ]
  },
  "pickUpItem": {
    "description": "Pick up an item that is lying on the map nearby, or take an item from another entity's hand.",
    "targetingType": "component",
    "range": 50,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "strength",
        "minValue": 5
      },
      {
        "trait": "Physical",
        "stat": "volume",
        "minValue": 1
      }
    ],
    "consequences": [
      {
        "type": "pickUpItem",
        "target": "target",
        "params": {
          "sourceEntityId": ":sourceEntityId",
          "sourceItemId": ":sourceItemId",
          "sourceComponentId": ":sourceComponentId",
          "targetEntityId": ":entityId",
          "targetComponentId": ":targetComponentId"
        }
      },
      {
        "type": "log",
        "target": "entity",
        "level": "info",
        "message": "Item ':itemType' picked up from entity ':sourceEntityId'"
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "Pick up failed - insufficient strength or volume, or target out of range"
      }
    ]
  },
  "shootT1": {
    "description": "Fire your T1 weapon. Consumes one stored projectile and deals impact damage equal to the projectile's volume.",
    "targetingType": "component",
    "range": 100,
    "requirements": [
      {
        "trait": "Physical",
        "stat": "existence",
        "minValue": 0.01
      }
    ],
    "consequences": [
      {
        "type": "consumeItemAndDamage",
        "target": "target",
        "params": {
          "channel": "impact",
          "value": 0
        },
        "damageSource": "equippedItem.firstChild.volume"
      },
      {
        "type": "dropMaterialChunk",
        "target": "target"
      },
      {
        "type": "log",
        "target": "self",
        "level": "info",
        "message": "T1 fired, consuming item with volume :itemVolume, dealing :itemVolume impact damage!"
      }
    ],
    "failureConsequences": [
      {
        "type": "log",
        "target": "entity",
        "level": "warn",
        "message": "T1 shoot failed - no ammunition in inventory"
      }
    ]
  }
}
