# ---------------------------------------------------------------------------
# slopSimulacrum — environment configuration example
#
# Copy this file to `.env` (or export these in your shell) and adjust as needed.
# Every variable is OPTIONAL and has a safe default for local development, so
# the server runs with zero configuration by default.
#
# Note: the server reads these from process.env at runtime. server.js loads
# `.env` automatically via dotenv as the first step of the boot, so the file
# works with zero launcher setup; shell-exported values take precedence over
# file entries (dotenv never overwrites existing process.env values by default).
# ---------------------------------------------------------------------------

# --- HTTP server -----------------------------------------------------------
# Port the Express/HTTP server listens on.
# Default: 3001
#PORT=3001

# --- HTTP transport (src/utils/serverBootstrap.js) -------------------------
# JSON body size limit for every request. The world API takes ids and small
# JSON, and an unbounded body turns any request into a memory event; the
# default is generous for those payloads and small against abuse. Override
# only with a reason.
# Default: 512kb
#MAX_BODY_LIMIT=512kb

# Comma-separated origins allowed to open the Socket.IO connection (CORS
# allowlist). The client is served from this same origin, so the default is
# intentionally empty = unrestricted (a default allowlist would break the
# local workflow). Set it before exposing the server, e.g.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Default: (empty -> unrestricted)
#CORS_ORIGINS=

# The request budget for the LLM-backed endpoints (POST /api/chat and
# POST /api/rooms/:roomId/chat) is NOT an environment knob: the limiter in
# src/utils/rateLimiter.js uses code-level defaults (windowMs 60000, max 20
# requests per window per IP). Change the code to change the budget; the 429
# contract is documented in the README Configuration section.

# --- LLM backend (src/controllers/networking/LLMController.js) -------------
# Base URL of the OpenAI-compatible chat-completions endpoint.
# Default: http://127.0.0.1:20003/v1/chat/completions
#LLM_ENDPOINT=http://127.0.0.1:20003/v1/chat/completions

# Optional bearer token sent as `Authorization: Bearer <key>`.
# When unset, no Authorization header is sent (local model / no auth).
# Default: (none)
#LLM_API_KEY=

# Default model id used when a call does not override `options.model`.
# Default: gpt-3.5-turbo
#LLM_MODEL=gpt-3.5-turbo

# Request timeout for a single LLM call, in milliseconds.
# Default: 30000
#LLM_TIMEOUT_MS=30000

# --- NPC agent thinking (src/controllers/networking/LLMAgentController.js) ----
# Lets the NPC agent round think before it acts. The round is the call the world
# fires for every NPC every turn, and the backend (llama.cpp + a Qwen3 GGUF)
# reasons by default, so this is OFF unless it is switched on: unset, empty, or
# any value that is not "true" sends
#     chat_template_kwargs: { "enable_thinking": false }
# "true", "TRUE" and " true " turn it on (the relaxed reading shared with
# KILLER_LLM_DRONE_ENABLED -- "1" does NOT count).
#
# Read on every round, like the other LLM knobs, so an `export` applies to the
# next round of a running world; editing this file still needs a restart, because
# dotenv loads it at boot.
#
# Only the agent round is gated. POST /api/chat and the agent-body designer are
# untouched -- the designer was given 10x the default max_tokens precisely because
# it needs its thinking budget, so a global switch would have quietly degraded it.
#
# Measured on this backend: off answers the same 16-token reply in 0.5 s vs 3.6 s
# on. `reasoning_effort` and a `thinking` kwarg were tried too and both are
# accepted with a 200 while changing nothing -- which is why the code sends
# enable_thinking and nothing else. See wiki/decisions/llm-agent-thinking.md.
# Default: (unset -> thinking off)
#LLM_AGENT_THINKING_ENABLED=true

# --- Killer LLM drone (data/entities/npcs.json, WorldStateController._spawnNpcs) ----
# The `killerLlmDrone` NPC entry is env-gated at spawn: it only spawns when
# KILLER_LLM_DRONE_ENABLED equals "true" after trimming and case-folding —
# "true", "TRUE", and " true " all enable it. Any other value (or unset/
# empty) leaves the drone OFF, which is the desired default.
# Unlike REQUIRE_AUTH, this gate is read ONCE at server bootstrap (when the
# NPCs are spawned) using that relaxed comparison — restart the server
# after changing it. REQUIRE_AUTH is instead read on every request with a
# strict "true" check; the two sites intentionally differ (see isEnvFlagOn
# in src/utils/Constants.js and src/utils/authMiddleware.js).
# Default: (unset -> drone disabled)
#KILLER_LLM_DRONE_ENABLED=true

# --- API authentication (src/utils/authMiddleware.js) ----------------------
# When set to "true", EVERY API request must carry a valid
# `Authorization: Bearer <API_TOKEN>` header. Any other value (or unset)
# disables the gate, which is the desired default for local development.
# Default: (unset -> auth disabled)
#REQUIRE_AUTH=false

# The shared secret token compared against the Bearer token when REQUIRE_AUTH
# is "true". Must be set for production. Leave unset in local dev.
# Default: (none)
#API_TOKEN=

# --- Logging (src/utils/Logger.js) -----------------------------------------
# Minimum severity level that reaches the console (DEBUG < INFO < WARN <
# ERROR < CRITICAL): with LOG_LEVEL=INFO the debug lines are suppressed and
# info/warn/error/critical are emitted. Read per log call; unset or an
# unrecognized value falls back to DEBUG (everything emitted — the default
# before this knob existed).
# Default: DEBUG
#LOG_LEVEL=INFO
