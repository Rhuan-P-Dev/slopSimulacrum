# ---------------------------------------------------------------------------
# slopSimulacrum — environment configuration example
#
# Copy this file to `.env` (or export these in your shell) and adjust as needed.
# Every variable is OPTIONAL and has a safe default for local development, so
# the server runs with zero configuration by default.
#
# Note: the server reads these from process.env at runtime. Node does not load
# `.env` automatically; use `dotenv` in your launcher or export them in the shell.
# ---------------------------------------------------------------------------

# --- HTTP server -----------------------------------------------------------
# Port the Express/HTTP server listens on.
# Default: 3001
#PORT=3001

# --- LLM backend (src/controllers/networking/LLMController.js) -------------
# Base URL of the OpenAI-compatible chat-completions endpoint.
# Default: http://127.0.0.1:20003/v1/chat/completions
#LLM_ENDPOINT=http://127.0.0.1:20003/v1/chat/completions

# Optional bearer token sent as `Authorization: Bearer <key>`.
# When unset, no Authorization header is sent (local model / no auth).
# Default: (none)
#LLM_API_KEY=

# Default model id used when a call does not override `options.model`.
# Default: gpt-3.5-turbo
#LLM_MODEL=gpt-3.5-turbo

# Request timeout for a single LLM call, in milliseconds.
# Default: 30000
#LLM_TIMEOUT_MS=30000

# --- Killer LLM drone (data/npcs.json, WorldStateController._spawnNpcs) ----
# The `killerLlmDrone` NPC entry is env-gated at spawn: it only spawns when
# KILLER_LLM_DRONE_ENABLED equals "true" after trimming and case-folding —
# "true", "TRUE", and " true " all enable it. Any other value (or unset/
# empty) leaves the drone OFF, which is the desired default.
# Unlike REQUIRE_AUTH, this gate is read ONCE at server bootstrap (when the
# NPCs are spawned) using that relaxed comparison — restart the server
# after changing it. REQUIRE_AUTH is instead read on every request with a
# strict "true" check; the two sites intentionally differ (see isEnvFlagOn
# in src/utils/Constants.js and src/utils/authMiddleware.js).
# Default: (unset -> drone disabled)
#KILLER_LLM_DRONE_ENABLED=true

# --- API authentication (src/utils/authMiddleware.js) ----------------------
# When set to "true", EVERY API request must carry a valid
# `Authorization: Bearer <API_TOKEN>` header. Any other value (or unset)
# disables the gate, which is the desired default for local development.
# Default: (unset -> auth disabled)
#REQUIRE_AUTH=false

# The shared secret token compared against the Bearer token when REQUIRE_AUTH
# is "true". Must be set for production. Leave unset in local dev.
# Default: (none)
#API_TOKEN=
